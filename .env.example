# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# Get a key at https://openrouter.ai/keys
# Browse model slugs and pricing at https://openrouter.ai/models
# (or run `repro models` once your key is set).

OPENROUTER_API_KEY=<<<PUT_YOUR_OPENROUTER_KEY_IN_.env>>>

# Any slug from https://openrouter.ai/models. Defaults to anthropic/claude-sonnet-5
# if unset. Good alternatives: anthropic/claude-opus-5 (stronger, pricier),
# openai/gpt-5.4 , google/gemini-3.5-flash (cheap).
OPENROUTER_MODEL=anthropic/claude-sonnet-5
